sName=\"book__img--wrapper\">\n          <img src={book.url} alt=\"\" className=\"book__img\" />\n        </figure>\n      </a>\n      <div className=\"book__title\">\n        <a href=\"/\" className=\"book__title--link\">\n          {book.title}\n        </a>\n        <div className=\"book__ratings\">\n          {\n            new Array(Math.floor(book.rating)).fill(0).map((_, index) => <FontAwesomeIcon icon=\"star\" key={index} />)\n          }\n          {\n            !Number.isInteger(book.rating) &&  <FontAwesomeIcon icon=\"star-half-alt\" />\n          }\n        </div>\n        <div className=\"book__price\">\n          {book.salePrice ? (\n            <>\n              <span className=\"book__price--normal\">${book.originalPrice.toFixed(2)}</span>\n              ${book.salePrice.toFixed(2)}\n            </>\n          ) : (\n            <>${book.originalPrice.toFixed(2)}</>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Book;\n","/Users/macuser/Desktop/React Library/src/components/Discounted.jsx",[],"/Users/macuser/Desktop/React Library/src/components/Explore.jsx",[],"/Users/macuser/Desktop/React Library/src/components/Footer.jsx",[],{"ruleId":"75","replacedBy":"76"},{"ruleId":"77","replacedBy":"78"},{"ruleId":"79","severity":1,"message":"80","line":8,"column":7,"nodeType":"81","endLine":8,"endColumn":18},"no-native-reassign",["82"],"no-negated-in-lhs",["83"],"jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","no-global-assign","no-unsafe-negation"]