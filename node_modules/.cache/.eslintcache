alePrice ? (\n            <>\n              <span className=\"book__price--normal\">${book.originalPrice.toFixed(2)}</span>\n              ${book.salePrice.toFixed(2)}\n            </>\n          ) : (\n            <>${book.originalPrice.toFixed(2)}</>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Book;\n","/Users/macuser/Desktop/React Library/src/components/Discounted.jsx",[],"/Users/macuser/Desktop/React Library/src/components/Explore.jsx",[],"/Users/macuser/Desktop/React Library/src/components/Footer.jsx",[],"/Users/macuser/Desktop/React Library/src/pages/Books.jsx",[],{"ruleId":"67","replacedBy":"68"},{"ruleId":"69","replacedBy":"70"},{"ruleId":"71","severity":1,"message":"72","line":8,"column":7,"nodeType":"73","endLine":8,"endColumn":18},"no-native-reassign",["74"],"no-negated-in-lhs",["75"],"jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","no-global-assign","no-unsafe-negation"]