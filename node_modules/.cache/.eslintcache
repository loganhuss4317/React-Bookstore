rt__title\">Cart</h2>\n            </div>\n            <div className=\"cart\">\n              <div className=\"cart__header\">\n                <span className=\"cart__book\">Book</span>\n                <span className=\"cart__quanitity\">Quantity</span>\n                <span className=\"cart__total\">Price</span>\n              </div>\n              <div className=\"cart__body\">\n                <div className=\"cart__item\">\n                  <div className=\"cart__book\">\n                    <img\n                      src=\"https://m.media-amazon.com/images/I/81ANaVZk5LL._AC_UF1000,1000_QL80_.jpg\"\n                      className=\"cart__book--img\"\n                    />\n                    <div className=\"cart__book--info\">\n                      <span className=\"cart__book--title\">Atomic Habits</span>\n                      <span className=\"cart__book--price\">$10.00</span>\n                      <button className=\"cart__book--remove\">Remove</button>\n                    </div>\n                  </div>\n                  <div className=\"cart__quantity\">\n                    <input\n                      type=\"number\"\n                      min={0}\n                      max={99}\n                      className=\"cart__input\"\n                    />\n                  </div>\n                  <div className=\"cart__total\">$10.00</div>\n                </div>\n              </div>\n            </div>\n            <div className=\"total\">\n              <div className=\"total__item total__sub-total\">\n                <span>Subtotal</span>\n                <span>$10.00</span>\n              </div>\n                <div className=\"total__item total__tax\">\n                  <span>Tax</span>\n                  <span>$1.00</span>\n                </div>\n                <div className=\"total__item total__price\">\n                  <span>Total</span>\n                  <span>$10.00</span>\n                </div>\n                <button className=\"btn btn__checkout no-cursor\"\n                onClick={() => alert(`Haven't gotten around to doing this :(`)}>\n                    Proceed to checkout\n                </button>\n              </div>\n            </div>\n          </div>\n      </main>\n    </div>\n  );\n};\n\nexport default Cart;\n",{"ruleId":"88","replacedBy":"89"},{"ruleId":"90","replacedBy":"91"},{"ruleId":"92","severity":1,"message":"93","line":1,"column":10,"nodeType":"94","messageId":"95","endLine":1,"endColumn":25},{"ruleId":"92","severity":1,"message":"96","line":2,"column":17,"nodeType":"94","messageId":"95","endLine":2,"endColumn":25},{"ruleId":"97","severity":1,"message":"98","line":10,"column":46,"nodeType":"99","messageId":"100","endLine":10,"endColumn":48},{"ruleId":"101","severity":1,"message":"102","line":35,"column":17,"nodeType":"103","endLine":35,"endColumn":71},{"ruleId":"101","severity":1,"message":"102","line":21,"column":21,"nodeType":"103","endLine":24,"endColumn":23},"no-native-reassign",["104"],"no-negated-in-lhs",["105"],"no-unused-vars","'FontAwesomeIcon' is defined but never used.","Identifier","unusedVar","'useState' is defined but never used.","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","unexpected","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","no-global-assign","no-unsafe-negation"]